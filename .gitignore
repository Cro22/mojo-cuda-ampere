# --- build artifacts ---------------------------------------------------------
# compiled CUDA binaries (make -C bench)
bench/build/
*.o
*.obj
*.out
a.out
*.exe

# CUDA / Mojo intermediates
*.ptx
*.cubin
*.fatbin
*.mojopkg

# --- profiling ---------------------------------------------------------------
# Nsight Compute/Systems raw reports (large); keep the .txt summaries
*.ncu-rep
*.nsys-rep
*.qdrep

# --- python / uv -------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
# NOTE: uv.lock IS committed on purpose (reproducible env); do not ignore it.

# --- editors / OS ------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- local tool state --------------------------------------------------------
# Claude Code local state / permissions, not shared
.claude/
# msys/mingw temp scratch files
.msys*

# --- results -----------------------------------------------------------------
# Tracked: results/results.csv and results/*.png (they are the deliverable).
# Ignored: bulky raw profiler dumps under results/ncu/.
results/ncu/*.ncu-rep
results/ncu/*.nsys-rep
